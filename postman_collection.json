  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Auto-wire Bearer Token fallback",
          "var currentBearer = pm.environment.get(\"bearerToken\") || pm.collectionVariables.get(\"bearerToken\");",
          "var currentUser = pm.environment.get(\"userToken\") || pm.collectionVariables.get(\"userToken\");",
          "var currentAdmin = pm.environment.get(\"adminToken\") || pm.collectionVariables.get(\"adminToken\");",
          "",
          "if (!currentUser && currentBearer) {",
          "    pm.variables.set(\"userToken\", currentBearer);",
          "}",
          "if (!currentAdmin && currentBearer) {",
          "    pm.variables.set(\"adminToken\", currentBearer);",
          "}"
        ]
      }
    }
  ]
