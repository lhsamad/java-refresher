  "item": [
    {
      "name": "0. Authentication & Registration",
      "item": [
        {
          "name": "Register New User (Public)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser\",\n  \"email\": \"testuser@example.com\",\n  \"password\": \"password123\",\n  \"fullName\": \"Test User\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "Registers a new user account with hashed credentials and ROLE_USER."
          }
        },
        {
          "name": "Generate User Token (user / user123)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access_token) {",
                  "    pm.environment.set(\"userToken\", jsonData.access_token);",
                  "    pm.collectionVariables.set(\"userToken\", jsonData.access_token);",
                  "    pm.environment.set(\"bearerToken\", jsonData.access_token);",
                  "    pm.collectionVariables.set(\"bearerToken\", jsonData.access_token);",
                  "    pm.test(\"User token captured & wired into {{userToken}} and {{bearerToken}}\", function () {",
                  "        pm.expect(jsonData.access_token).to.be.a(\"string\");",
                  "    });",
                  "} else {",
                  "    pm.test(\"Failed to retrieve access_token\", function () {",
                  "        pm.expect.fail(\"No access_token found in response\");",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "password",
                  "type": "text"
                },
                {
                  "key": "client_id",
                  "value": "spring-boot-public",
                  "type": "text"
                },
                {
                  "key": "username",
                  "value": "user",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "user123",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{keycloakUrl}}/protocol/openid-connect/token",
              "host": [
                "{{keycloakUrl}}"
              ],
              "path": [
                "protocol",
                "openid-connect",
                "token"
              ]
            },
            "description": "Requests an OAuth2 JWT token for regular user (ROLE_USER) from Keycloak. The test script automatically saves the access token into {{userToken}}."
          }
        },
        {
          "name": "Generate Admin Token (admin / admin123)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access_token) {",
                  "    pm.environment.set(\"adminToken\", jsonData.access_token);",
                  "    pm.collectionVariables.set(\"adminToken\", jsonData.access_token);",
                  "    pm.environment.set(\"bearerToken\", jsonData.access_token);",
                  "    pm.collectionVariables.set(\"bearerToken\", jsonData.access_token);",
                  "    // Admin also has ROLE_USER; wire to userToken if unset",
                  "    if (!pm.environment.get(\"userToken\") && !pm.collectionVariables.get(\"userToken\")) {",
                  "        pm.environment.set(\"userToken\", jsonData.access_token);",
                  "        pm.collectionVariables.set(\"userToken\", jsonData.access_token);",
                  "    }",
                  "    pm.test(\"Admin token captured & wired into {{adminToken}} and {{bearerToken}}\", function () {",
                  "        pm.expect(jsonData.access_token).to.be.a(\"string\");",
                  "    });",
                  "} else {",
                  "    pm.test(\"Failed to retrieve access_token\", function () {",
                  "        pm.expect.fail(\"No access_token found in response\");",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "password",
                  "type": "text"
                },
                {
                  "key": "client_id",
                  "value": "spring-boot-public",
                  "type": "text"
                },
                {
                  "key": "username",
                  "value": "admin",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "admin123",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{keycloakUrl}}/protocol/openid-connect/token",
              "host": [
                "{{keycloakUrl}}"
              ],
              "path": [
                "protocol",
                "openid-connect",
                "token"
              ]
            },
            "description": "Requests an OAuth2 JWT token for admin user (ROLE_ADMIN, ROLE_USER) from Keycloak. The test script automatically saves the access token into {{adminToken}}."
          }
        },
        {
          "name": "Generate Token (Confidential Client)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access_token) {",
                  "    pm.environment.set(\"userToken\", jsonData.access_token);",
                  "    pm.collectionVariables.set(\"userToken\", jsonData.access_token);",
                  "    pm.environment.set(\"bearerToken\", jsonData.access_token);",
                  "    pm.collectionVariables.set(\"bearerToken\", jsonData.access_token);",
                  "    pm.test(\"Client token captured & wired into {{userToken}} and {{bearerToken}}\", function () {",
                  "        pm.expect(jsonData.access_token).to.be.a(\"string\");",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "password",
                  "type": "text"
                },
                {
                  "key": "client_id",
                  "value": "spring-boot-client",
                  "type": "text"
                },
                {
                  "key": "client_secret",
                  "value": "spring-boot-client-secret",
                  "type": "text"
                },
                {
                  "key": "username",
                  "value": "user",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "user123",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{keycloakUrl}}/protocol/openid-connect/token",
              "host": [
                "{{keycloakUrl}}"
              ],
              "path": [
                "protocol",
                "openid-connect",
                "token"
              ]
            },
            "description": "Alternate request using the confidential client 'spring-boot-client' with client_secret."
          }
        }
      ]
    },
