    {
      "name": "6. Spring Batch Pipeline",
      "item": [
        {
          "name": "Import Products CSV (500 items/chunk)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/batch/import?inputCsvPath={{inputCsvPath}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "batch",
                "import"
              ],
              "query": [
                {
                  "key": "inputCsvPath",
                  "value": "{{inputCsvPath}}"
                }
              ]
            },
            "description": "Triggers the dedicated CSV import batch job (importProductsJob) to stream products from CSV into PostgreSQL in chunks of 500 items via JdbcBatchItemWriter. Automatically captures {{jobExecutionId}}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.jobExecutionId) {",
                  "    pm.environment.set(\"jobExecutionId\", jsonData.jobExecutionId.toString());",
                  "    pm.collectionVariables.set(\"jobExecutionId\", jsonData.jobExecutionId.toString());",
                  "    pm.test(\"Import Job launched and {{jobExecutionId}} saved: \" + jsonData.jobExecutionId, function () {",
                  "        pm.expect(jsonData.jobExecutionId).to.be.a(\"number\");",
                  "        pm.expect(jsonData.status).to.be.oneOf([\"STARTING\", \"STARTED\", \"COMPLETED\"]);",
                  "        pm.expect(jsonData.chunkSize).to.eql(500);",
                  "    });",
                  "} else {",
                  "    pm.test(\"Failed to launch import batch job\", function () {",
                  "        pm.expect.fail(\"No jobExecutionId found in response\");",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Trigger Full Batch Pipeline (CSV -> DB -> JSON)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/batch/run?inputCsvPath={{inputCsvPath}}&outputJsonPath={{outputJsonPath}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "batch",
                "run"
              ],
              "query": [
                {
                  "key": "inputCsvPath",
                  "value": "{{inputCsvPath}}"
                },
                {
                  "key": "outputJsonPath",
                  "value": "{{outputJsonPath}}"
                }
              ]
            },
